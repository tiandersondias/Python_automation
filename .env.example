# Copy to a secret-managed environment; do not commit the populated file.
# Require TLS for non-local PostgreSQL connections.
#
# Application login credentials. Store these in the deployment secret manager.
WAREHOUSE_USERNAME=operator
WAREHOUSE_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://warehouse_app:REPLACE_ME@db.example.com:5432/warehouse?sslmode=require
TEST_DATABASE_URL=postgresql://warehouse_test:REPLACE_ME@localhost:5432/warehouse_test?sslmode=require
